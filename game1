                const file = event.target.files[0];
                if (!file) return;
                
                const reader = new FileReader();
                reader.onload = function(e) {
                    try {
                        const importedData = JSON.parse(e.target.result);
                        
                        // Validate data structure
                        if (!importedData.questionPackages || !importedData.gameName) {
                            throw new Error('Format file tidak valid');
                        }
                        
                        if (confirm(`🔄 Import Data Backup\n\nFile: ${file.name}\nTanggal backup: ${new Date(importedData.exportDate).toLocaleString('id-ID')}\n\n⚠️ PERINGATAN: Semua data saat ini akan diganti!\n\nLanjutkan import?`)) {
