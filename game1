        async function saveEditedQuestion() {
            const newPackage = document.getElementById('editPackage').value;
            const question = document.getElementById('editQuestionText').value.trim();
            const option1 = document.getElementById('editOption1').value.trim();
            const option2 = document.getElementById('editOption2').value.trim();
            const option3 = document.getElementById('editOption3').value.trim();
            const option4 = document.getElementById('editOption4').value.trim();
            const option5 = document.getElementById('editOption5').value.trim();
            const correct = document.getElementById('editCorrectAnswer').value;

            if (!question || !option1 || !option2 || !option3 || !option4 || !option5 || correct === '') {
                alert('Silakan lengkapi semua field!');
                return;
            }

            try {
                // Get images
                const questionImageInput = document.getElementById('editQuestionImage');
                const optionImageInputs = [
                    document.getElementById('editOption1Image'),
                    document.getElementById('editOption2Image'),
                    document.getElementById('editOption3Image'),
                    document.getElementById('editOption4Image'),
                    document.getElementById('editOption5Image')
                ];

                // Get existing question data
                const oldQuestion = questionPackages[currentEditingQuestion.packageKey].questions[currentEditingQuestion.index];
                
                // Process images (keep existing if no new image uploaded)
                let questionImage = oldQuestion.questionImage;
                const optionImages = [...(oldQuestion.optionImages || [null, null, null, null, null])];

                // Process question image
                if (questionImageInput.files && questionImageInput.files[0]) {
                    questionImage = await fileToBase64(questionImageInput.files[0]);
                }

                // Process option images
                for (let i = 0; i < optionImageInputs.length; i++) {
                    if (optionImageInputs[i].files && optionImageInputs[i].files[0]) {
                        optionImages[i] = await fileToBase64(optionImageInputs[i].files[0]);
                    }
                }

                const updatedQuestion = {
                    question: question,
                    questionImage: questionImage,
                    options: [option1, option2, option3, option4, option5],
                    optionImages: optionImages,
                    correct: parseInt(correct)
                };

                // Remove from old package if package changed
                if (currentEditingQuestion.packageKey !== newPackage) {
                    questionPackages[currentEditingQuestion.packageKey].questions.splice(currentEditingQuestion.index, 1);
                    questionPackages[newPackage].questions.push(updatedQuestion);
                } else {
                    // Update in same package
                    questionPackages[currentEditingQuestion.packageKey].questions[currentEditingQuestion.index] = updatedQuestion;
                }
                
                // Auto-save changes
                autoSave();
                
                closeEditModal();
                displayQuestions();
                alert('Soal berhasil diperbarui dan disimpan! ✅');

            } catch (error) {
                alert('Terjadi kesalahan saat menyimpan soal. Silakan coba lagi.');
                console.error('Save error:', error);
            }
        }

