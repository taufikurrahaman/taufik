        function selectPackage(packageNumber) {
            gameState.selectedPackage = packageNumber;
            gameState.questions = [...questionPackages[packageNumber].questions];
            startGame();
        }

        // Student Game Functions
        function startGame() {
            // Reset game state
            gameState.score = 40;
            gameState.timeLeft = 180;
            gameState.currentQuestion = 0;
            gameState.correctAnswersCount = 0;
            gameState.selectedAnswers = [];
            gameState.questionStates = gameState.questions.map(() => ({
                selectedAnswers: [],
                isAnswered: false,
                isCorrect: false
            }));

            hideAllScreens();
            document.getElementById('gameScreen').classList.remove('hidden');
            document.getElementById('playerName').textContent = gameState.currentPlayer;
            
            updateGameDisplay();
            createQuestionNavigationPanel();
            loadQuestion();
            startTimer();
        }

        function startTimer() {
            gameState.gameTimer = setInterval(() => {
                gameState.timeLeft--;
                document.getElementById('timer').textContent = gameState.timeLeft;
                
                if (gameState.timeLeft <= 0) {
                    endGame();
                }
            }, 1000);
        }

        function loadQuestion() {
            if (gameState.currentQuestion >= gameState.questions.length) {
                endGame();
                return;
            }

            const question = gameState.questions[gameState.currentQuestion];
            const questionState = gameState.questionStates[gameState.currentQuestion];
            
            // Display question text
            document.getElementById('questionText').innerHTML = question.question + 
                (question.questionImage ? `<br><img src="${question.questionImage}" alt="Question Image" class="mt-3 max-w-full h-48 object-contain rounded-lg border mx-auto">` : '');
            
            document.getElementById('questionNumber').textContent = gameState.currentQuestion + 1;
            document.getElementById('totalQuestions').textContent = gameState.questions.length;
            
            const progress = ((gameState.currentQuestion + 1) / gameState.questions.length) * 100;
            document.getElementById('progressBar').style.width = progress + '%';

            const container = document.getElementById('optionsContainer');
            container.innerHTML = '';

            // Update current selected answers from question state
            gameState.selectedAnswers = [...questionState.selectedAnswers];

            question.options.forEach((option, index) => {
                const button = document.createElement('button');
                let buttonClass = 'w-full p-4 text-left border-2 border-gray-300 rounded-xl hover:border-blue-500 hover:bg-blue-50 transition-all duration-300 transform hover:scale-105';
                let buttonContent = `<div class="flex items-center gap-3">
                    <span class="font-semibold text-blue-600 flex-shrink-0">${String.fromCharCode(65 + index)}.</span>
                    <div class="flex-1">
                        <div>${option}</div>
                        ${question.optionImages && question.optionImages[index] ? 
                            `<img src="${question.optionImages[index]}" alt="Option ${String.fromCharCode(65 + index)}" class="mt-2 max-w-full h-20 object-contain rounded border">` : 
                            ''}
                    </div>
                </div>`;
                
                // Restore previous state
                if (questionState.selectedAnswers.includes(index)) {
                    if (index === question.correct) {
                        buttonClass = 'w-full p-4 text-left border-2 border-green-500 bg-green-100 rounded-xl';
                        buttonContent = buttonContent.replace('</div></div>', ' ✓</div></div>');
                        button.disabled = true;
                    } else {
                        buttonClass = 'w-full p-4 text-left border-2 border-red-500 bg-red-100 rounded-xl opacity-50';
                        buttonContent = buttonContent.replace('</div></div>', ' ✗</div></div>');
                        button.disabled = true;
                    }
                } else if (questionState.isAnswered && index === question.correct) {
                    buttonClass = 'w-full p-4 text-left border-2 border-green-500 bg-green-100 rounded-xl';
                    buttonContent = buttonContent.replace('</div></div>', ' ✓ (Jawaban Benar)</div></div>');
                    button.disabled = true;
                }
                
                button.className = buttonClass;
                button.innerHTML = buttonContent;
                button.onclick = () => selectAnswer(index);
                button.id = `option-${index}`;
                container.appendChild(button);
            });
            
            // Update navigation buttons and panel
            updateNavigationButtons();
            updateQuestionNavigationPanel();
        }

        function createQuestionNavigationPanel() {
            const panel = document.getElementById('questionNavigationPanel');
            panel.innerHTML = '';

            for (let i = 0; i < gameState.questions.length; i++) {
                const button = document.createElement('button');
                button.className = 'w-10 h-10 rounded-lg font-bold text-sm transition-all duration-300 hover:scale-110';
                button.textContent = i + 1;
                button.onclick = () => navigateToQuestion(i);
                button.id = `nav-question-${i}`;
                panel.appendChild(button);
            }
            
            updateQuestionNavigationPanel();
        }

        function updateQuestionNavigationPanel() {
            for (let i = 0; i < gameState.questions.length; i++) {
                const button = document.getElementById(`nav-question-${i}`);
                if (!button) continue;

                const questionState = gameState.questionStates[i];
                
                if (i === gameState.currentQuestion) {
                    // Current question - blue
                    button.className = 'w-10 h-10 rounded-lg font-bold text-sm transition-all duration-300 hover:scale-110 bg-blue-500 text-white border-2 border-blue-600 shadow-lg';
                } else if (questionState.isAnswered) {
                    // Answered question - green
                    button.className = 'w-10 h-10 rounded-lg font-bold text-sm transition-all duration-300 hover:scale-110 bg-green-500 text-white border-2 border-green-600';
                } else {
                    // Unanswered question - gray
                    button.className = 'w-10 h-10 rounded-lg font-bold text-sm transition-all duration-300 hover:scale-110 bg-gray-300 text-gray-700 border-2 border-gray-400 hover:bg-gray-400 hover:text-white';
                }
            }
        }

        function navigateToQuestion(questionIndex) {
            if (questionIndex >= 0 && questionIndex < gameState.questions.length) {
                gameState.currentQuestion = questionIndex;
                loadQuestion();
            }
        }

        function selectAnswer(selectedIndex) {
            const question = gameState.questions[gameState.currentQuestion];
            const questionState = gameState.questionStates[gameState.currentQuestion];
            const selectedButton = document.getElementById(`option-${selectedIndex}`);
            
            // Check if this answer was already selected
            if (gameState.selectedAnswers.includes(selectedIndex)) {
                return;
            }

            // Check if question was already answered correctly - prevent any further selection
            if (questionState.isAnswered && questionState.isCorrect) {
                return;
            }

            if (selectedIndex === question.correct) {
                // Correct answer
                selectedButton.className = 'w-full p-4 text-left border-2 border-green-500 bg-green-100 rounded-xl';
                selectedButton.innerHTML += ' ✓';
                gameState.score += 20;
                gameState.correctAnswersCount++;
                
                // Update question state
                questionState.selectedAnswers.push(selectedIndex);
                questionState.isAnswered = true;
                questionState.isCorrect = true;
                gameState.selectedAnswers.push(selectedIndex);
                
                // Disable all buttons
                const buttons = document.querySelectorAll('#optionsContainer button');
                buttons.forEach(btn => btn.disabled = true);
                
                updateGameDisplay();
                updateQuestionNavigationPanel();
                
                // Check if score reaches 100 (end game with victory)
                if (gameState.score >= 100) {
                    setTimeout(() => {
                        alert('🎉 Selamat! Anda mencapai poin maksimal (100)! Permainan selesai dengan sempurna! 🏆');
                        endGame();
                    }, 2000);
                    return;
                }
            } else {
                // Wrong answer - hide the option and deduct points
                selectedButton.className = 'w-full p-4 text-left border-2 border-red-500 bg-red-100 rounded-xl opacity-50';
                selectedButton.innerHTML += ' ✗';
                selectedButton.disabled = true;
                
                gameState.selectedAnswers.push(selectedIndex);
                questionState.selectedAnswers.push(selectedIndex);
                gameState.score = Math.max(0, gameState.score - 10);
                
                updateGameDisplay();
                
                // Check if game should end due to low score
                if (gameState.score <= 10) {
                    // Show correct answer
                    const correctButton = document.getElementById(`option-${question.correct}`);
                    correctButton.className = 'w-full p-4 text-left border-2 border-green-500 bg-green-100 rounded-xl';
                    correctButton.innerHTML += ' ✓ (Jawaban Benar)';
                    
                    questionState.isAnswered = true;
                    questionState.isCorrect = false;
                    
                    // Disable all remaining buttons
                    const buttons = document.querySelectorAll('#optionsContainer button');
                    buttons.forEach(btn => btn.disabled = true);
                    
                    updateQuestionNavigationPanel();
                    
                    // End game due to low score
                    setTimeout(() => {
                        alert('Game berakhir! Poin Anda sudah terlalu rendah (≤10). Tetap semangat belajar! 💪');
                        endGame();
                    }, 2000);
                    return;
                }
                
                // Check if all wrong answers selected (show correct answer but continue game)
                const remainingOptions = question.options.length - gameState.selectedAnswers.length - 1; // -1 for correct answer
                if (remainingOptions <= 0) {
                    // Show correct answer and end question
                    const correctButton = document.getElementById(`option-${question.correct}`);
                    correctButton.className = 'w-full p-4 text-left border-2 border-green-500 bg-green-100 rounded-xl';
                    correctButton.innerHTML += ' ✓ (Jawaban Benar)';
                    
                    questionState.isAnswered = true;
                    questionState.isCorrect = false;
                    
                    // Disable all remaining buttons
                    const buttons = document.querySelectorAll('#optionsContainer button');
                    buttons.forEach(btn => btn.disabled = true);
                    
                    updateQuestionNavigationPanel();
                }
            }
        }

        function updateGameDisplay() {
            // Cap displayed score at maximum 100 points
            const displayScore = Math.min(gameState.score, 100);
            document.getElementById('score').textContent = displayScore;
        }

        function endGame() {
            clearInterval(gameState.gameTimer);
            
            // Save result (cap score at maximum 100 points)
            const result = {
                name: gameState.currentPlayer,
                class: gameState.currentClass,
                score: Math.min(gameState.score, 100),
                timeUsed: 180 - gameState.timeLeft,
                date: new Date().toLocaleString('id-ID')
            };
            gameState.studentResults.push(result);
            
            // Auto-save student results
            autoSave();
            
            // Show results (cap at maximum 100 points)
            const finalDisplayScore = Math.min(gameState.score, 100);
            document.getElementById('finalScore').textContent = finalDisplayScore;
            document.getElementById('correctAnswers').textContent = gameState.correctAnswersCount;
            document.getElementById('remainingTime').textContent = gameState.timeLeft + ' detik';
            
            hideAllScreens();
            document.getElementById('resultsScreen').classList.remove('hidden');
        }

        function nextQuestion() {
            if (gameState.currentQuestion < gameState.questions.length - 1) {
                gameState.currentQuestion++;
                loadQuestion();
            }
        }

        function previousQuestion() {
            if (gameState.currentQuestion > 0) {
                gameState.currentQuestion--;
                loadQuestion();
            }
        }

        function updateNavigationButtons() {
            const prevButton = document.getElementById('prevButton');
            const skipButton = document.getElementById('skipButton');
            
            // Disable previous button if on first question
            if (gameState.currentQuestion === 0) {
                prevButton.disabled = true;
                prevButton.className = 'bg-gray-500 text-white px-6 py-3 rounded-xl font-semibold opacity-50 cursor-not-allowed';
            } else {
                prevButton.disabled = false;
                prevButton.className = 'bg-gray-500 text-white px-6 py-3 rounded-xl font-semibold hover:bg-gray-600 transition-colors';
            }
            
            // Update skip button text if on last question
            if (gameState.currentQuestion === gameState.questions.length - 1) {
                skipButton.textContent = 'Selesai';
                skipButton.onclick = () => endGame();
            } else {
                skipButton.textContent = 'Lanjut →';
                skipButton.onclick = () => nextQuestion();
            }
        }

