<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Game Edukasi Pilihan Ganda</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');
        body { font-family: 'Poppins', sans-serif; }
        .fade-in { animation: fadeIn 0.5s ease-in; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        .pulse-animation { animation: pulse 2s infinite; }
        @keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.05); } }
    </style>
</head>
<body class="bg-gradient-to-br from-blue-400 via-purple-500 to-pink-500 min-h-screen">
    <!-- Login Screen -->
    <div id="loginScreen" class="min-h-screen flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl p-8 w-full max-w-md fade-in">
            <div class="text-center mb-8">
                <div class="bg-gradient-to-r from-blue-500 to-purple-600 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
                    <span class="text-white text-2xl font-bold">📚</span>
                </div>
                <h1 id="loginGameTitle" class="text-3xl font-bold text-gray-800 mb-2">Game Edukasi</h1>
                <p class="text-gray-600">Pilihan Ganda Interaktif</p>
            </div>
            
            <div class="space-y-4">
                <button onclick="showStudentLogin()" class="w-full bg-gradient-to-r from-green-500 to-green-600 text-white py-4 rounded-xl font-semibold text-lg hover:from-green-600 hover:to-green-700 transition-all duration-300 transform hover:scale-105">
                    🎓 Masuk Sebagai Siswa
                </button>
                <button onclick="showTeacherLogin()" class="w-full bg-gradient-to-r from-blue-500 to-blue-600 text-white py-4 rounded-xl font-semibold text-lg hover:from-blue-600 hover:to-blue-700 transition-all duration-300 transform hover:scale-105">
                    👨‍🏫 Masuk Sebagai Guru
                </button>
            </div>
        </div>
    </div>

    <!-- Student Login -->
    <div id="studentLogin" class="min-h-screen flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-2xl shadow-2xl p-8 w-full max-w-md fade-in">
            <h2 class="text-2xl font-bold text-center text-gray-800 mb-6">Login Siswa</h2>
            <div class="space-y-4">
                <input type="text" id="studentName" placeholder="Masukkan nama Anda" class="w-full p-4 border-2 border-gray-300 rounded-xl focus:border-green-500 focus:outline-none transition-colors">
                <input type="text" id="studentClass" placeholder="Masukkan kelas Anda (contoh: 5A, 6B, dll)" class="w-full p-4 border-2 border-gray-300 rounded-xl focus:border-green-500 focus:outline-none transition-colors">
                <button onclick="showPackageSelection()" class="w-full bg-gradient-to-r from-green-500 to-green-600 text-white py-4 rounded-xl font-semibold hover:from-green-600 hover:to-green-700 transition-all duration-300">
                    Lanjut
                </button>
                <button onclick="showLoginScreen()" class="w-full text-gray-600 py-2 hover:text-gray-800 transition-colors">
                    ← Kembali
                </button>
            </div>
        </div>
    </div>

    <!-- Package Selection -->
    <div id="packageSelection" class="min-h-screen flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-2xl shadow-2xl p-8 w-full max-w-2xl fade-in">
            <h2 class="text-3xl font-bold text-center text-gray-800 mb-2">Pilih Paket Soal</h2>
            <p class="text-center text-gray-600 mb-8">Halo, <span id="studentNameDisplay" class="text-blue-600 font-semibold"></span>! Pilih paket soal yang ingin kamu kerjakan</p>
            
            <div class="grid md:grid-cols-3 gap-6" id="packageSelectionCards">
                <!-- Package cards will be dynamically updated -->
            </div>

            <div class="text-center mt-8">
                <button onclick="showStudentLogin()" class="text-gray-600 py-2 px-4 hover:text-gray-800 transition-colors">
                    ← Kembali
                </button>
            </div>
        </div>
    </div>

    <!-- Teacher Login -->
    <div id="teacherLogin" class="min-h-screen flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-2xl shadow-2xl p-8 w-full max-w-md fade-in">
            <h2 class="text-2xl font-bold text-center text-gray-800 mb-6">Login Guru</h2>
            <div class="space-y-4">
                <input type="text" id="teacherUsername" placeholder="Username" class="w-full p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none transition-colors">
                <input type="password" id="teacherPassword" placeholder="Password" class="w-full p-4 border-2 border-gray-300 rounded-xl focus:border-blue-500 focus:outline-none transition-colors">
                <button onclick="teacherLogin()" class="w-full bg-gradient-to-r from-blue-500 to-blue-600 text-white py-4 rounded-xl font-semibold hover:from-blue-600 hover:to-blue-700 transition-all duration-300">
                    Login
                </button>
                <button onclick="showLoginScreen()" class="w-full text-gray-600 py-2 hover:text-gray-800 transition-colors">
                    ← Kembali
                </button>
            </div>
        </div>
    </div>

    <!-- Game Screen -->
    <div id="gameScreen" class="min-h-screen p-4 hidden">
        <div class="max-w-4xl mx-auto">
            <!-- Header -->
            <div class="bg-white rounded-2xl shadow-lg p-6 mb-6 fade-in">
                <div class="flex justify-between items-center flex-wrap gap-4">
                    <div>
                        <h2 class="text-2xl font-bold text-gray-800">Halo, <span id="playerName" class="text-blue-600"></span>!</h2>
                        <p class="text-gray-600">Jawab pertanyaan dengan benar untuk mendapat poin</p>
                    </div>
                    <div class="flex gap-6 text-center">
                        <div class="bg-green-100 px-4 py-2 rounded-xl">
                            <div class="text-2xl font-bold text-green-600" id="score">40</div>
                            <div class="text-sm text-green-700">Poin</div>
                        </div>

                        <div class="bg-red-100 px-4 py-2 rounded-xl">
                            <div class="text-2xl font-bold text-red-600" id="timer">180</div>
                            <div class="text-sm text-red-700">Detik</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Question Navigation Panel -->
            <div class="bg-white rounded-2xl shadow-lg p-6 mb-6 fade-in">
                <div class="flex justify-between items-center mb-4">
                    <h3 class="text-lg font-bold text-gray-800">📋 Panel Navigasi Soal</h3>
                    <div class="flex gap-4 text-sm">
                        <div class="flex items-center gap-2">
                            <div class="w-4 h-4 bg-green-500 rounded"></div>
                            <span class="text-gray-600">Sudah Dijawab</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <div class="w-4 h-4 bg-blue-500 rounded"></div>
                            <span class="text-gray-600">Sedang Aktif</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <div class="w-4 h-4 bg-gray-300 rounded"></div>
                            <span class="text-gray-600">Belum Dijawab</span>
                        </div>
                    </div>
                </div>
                <div id="questionNavigationPanel" class="grid grid-cols-5 sm:grid-cols-10 gap-2">
                    <!-- Question navigation buttons will be generated here -->
                </div>
            </div>

            <!-- Question Card -->
            <div class="bg-white rounded-2xl shadow-lg p-8 mb-6 fade-in">
                <div class="mb-6">
                    <div class="flex justify-between items-center mb-4">
                        <span class="bg-purple-100 text-purple-700 px-3 py-1 rounded-full text-sm font-medium">
                            Soal <span id="questionNumber">1</span> dari <span id="totalQuestions">5</span>
                        </span>
                        <div class="w-full bg-gray-200 rounded-full h-2 ml-4">
                            <div id="progressBar" class="bg-gradient-to-r from-purple-500 to-pink-500 h-2 rounded-full transition-all duration-300" style="width: 20%"></div>
                        </div>
                    </div>
                    <h3 id="questionText" class="text-xl font-semibold text-gray-800 leading-relaxed">
                        Loading...
                    </h3>
                </div>

                <div id="optionsContainer" class="space-y-3">
                    <!-- Options will be generated here -->
                </div>
            </div>

            <!-- Navigation Buttons -->
            <div class="flex justify-center gap-4 mb-4">
                <button id="prevButton" onclick="previousQuestion()" class="bg-gray-500 text-white px-6 py-3 rounded-xl font-semibold hover:bg-gray-600 transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
                    ← Mundur
                </button>
                <button id="skipButton" onclick="nextQuestion()" class="bg-blue-500 text-white px-6 py-3 rounded-xl font-semibold hover:bg-blue-600 transition-colors">
                    Lanjut →
                </button>
            </div>

            <!-- Action Buttons -->
            <div class="text-center">
                <button onclick="endGame()" class="bg-red-500 text-white px-6 py-3 rounded-xl font-semibold hover:bg-red-600 transition-colors">
                    Selesai Game
                </button>
            </div>
        </div>
    </div>

    <!-- Teacher Dashboard -->
    <div id="teacherDashboard" class="min-h-screen p-4 hidden">
        <div class="max-w-6xl mx-auto">
            <!-- Header -->
            <div class="bg-white rounded-2xl shadow-lg p-6 mb-6 fade-in">
                <div class="flex justify-between items-center">
                    <div>
                        <h2 class="text-3xl font-bold text-gray-800">Dashboard Guru</h2>
                        <p class="text-gray-600 mt-1">Kelola game: <span id="currentGameName" class="text-blue-600 font-semibold">Game Edukasi</span></p>
                        <p class="text-xs text-green-600 mt-1">💾 Data tersimpan otomatis di browser</p>
                    </div>
                    <div class="flex gap-2 flex-wrap">
                        <button onclick="showEditGameNameModal()" class="bg-blue-500 text-white px-3 py-2 rounded-lg hover:bg-blue-600 transition-colors flex items-center gap-1 text-sm">
                            ✏️ Edit Nama
                        </button>
                        <button onclick="exportAllData()" class="bg-green-500 text-white px-3 py-2 rounded-lg hover:bg-green-600 transition-colors flex items-center gap-1 text-sm">
                            📦 Backup
                        </button>
                        <button onclick="importAllData()" class="bg-purple-500 text-white px-3 py-2 rounded-lg hover:bg-purple-600 transition-colors flex items-center gap-1 text-sm">
                            📥 Import
                        </button>
                        <button onclick="clearAllData()" class="bg-orange-500 text-white px-3 py-2 rounded-lg hover:bg-orange-600 transition-colors flex items-center gap-1 text-sm">
                            🗑️ Reset
                        </button>
                        <button onclick="logout()" class="bg-red-500 text-white px-3 py-2 rounded-lg hover:bg-red-600 transition-colors text-sm">
                            Logout
                        </button>
                    </div>
                </div>
            </div>

            <!-- Template & Upload Section -->
            <div class="bg-white rounded-2xl shadow-lg p-6 mb-6 fade-in">
                <h3 class="text-xl font-bold text-gray-800 mb-4">📁 Kelola Soal</h3>
                
                <!-- Template Download Options -->
                <div class="mb-6">
                    <h4 class="text-lg font-semibold text-gray-700 mb-3">📥 Unduh Template</h4>
                    <div class="grid md:grid-cols-3 gap-3">
                        <button onclick="downloadWordTemplate()" class="bg-gradient-to-r from-blue-500 to-blue-600 text-white py-3 px-4 rounded-lg font-semibold hover:from-blue-600 hover:to-blue-700 transition-all duration-300 flex items-center justify-center gap-2 text-sm">
                            📄 Template Word
                        </button>
                        <button onclick="openGoogleDocsTemplate()" class="bg-gradient-to-r from-green-500 to-green-600 text-white py-3 px-4 rounded-lg font-semibold hover:from-green-600 hover:to-green-700 transition-all duration-300 flex items-center justify-center gap-2 text-sm">
                            📝 Google Docs
                        </button>
                        <button onclick="downloadExcelTemplate()" class="bg-gradient-to-r from-orange-500 to-orange-600 text-white py-3 px-4 rounded-lg font-semibold hover:from-orange-600 hover:to-orange-700 transition-all duration-300 flex items-center justify-center gap-2 text-sm">
                            📊 Template Excel
                        </button>
                    </div>
                </div>

                <!-- Upload Options -->
                <div class="mb-4">
                    <h4 class="text-lg font-semibold text-gray-700 mb-3">📤 Upload Soal</h4>
                    <div class="grid md:grid-cols-2 gap-3">
                        <div class="relative">
                            <input type="file" id="uploadFile" accept=".docx,.doc,.xlsx,.xls,.csv,.txt" onchange="uploadQuestions()" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer">
                            <button class="w-full bg-gradient-to-r from-purple-500 to-purple-600 text-white py-3 px-4 rounded-lg font-semibold hover:from-purple-600 hover:to-purple-700 transition-all duration-300 flex items-center justify-center gap-2 text-sm">
                                📁 Upload File
                            </button>
                        </div>
                        <button onclick="showGoogleDocsImport()" class="bg-gradient-to-r from-indigo-500 to-indigo-600 text-white py-3 px-4 rounded-lg font-semibold hover:from-indigo-600 hover:to-indigo-700 transition-all duration-300 flex items-center justify-center gap-2 text-sm">
                            🔗 Import Google Docs
                        </button>
                    </div>
                </div>

                <div class="p-4 bg-gradient-to-r from-blue-50 to-green-50 rounded-lg text-sm">
                    <div class="flex items-start gap-3">
                        <span class="text-2xl">💡</span>
                        <div>
                            <p class="font-semibold text-gray-800 mb-2">Format yang Didukung:</p>
                            <div class="grid md:grid-cols-2 gap-2 text-gray-700">
                                <div>• 📄 Word (.docx, .doc)</div>
                                <div>• 📝 Google Docs (link)</div>
                                <div>• 📊 Excel (.xlsx, .xls)</div>
                                <div>• 📋 CSV (.csv)</div>
                            </div>
                            <p class="mt-2 text-blue-700"><strong>Rekomendasi:</strong> Gunakan template Word atau Google Docs untuk kemudahan editing!</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Google Docs Import Modal -->
            <div id="googleDocsModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 hidden z-50">
                <div class="bg-white rounded-2xl shadow-2xl p-6 w-full max-w-md">
                    <h3 class="text-xl font-bold text-gray-800 mb-4">📝 Import dari Google Docs</h3>
                    <div class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Link Google Docs:</label>
                            <input type="url" id="googleDocsLink" placeholder="https://docs.google.com/document/d/..." class="w-full p-3 border-2 border-gray-300 rounded-lg focus:border-blue-500 focus:outline-none transition-colors">
                        </div>
                        <div class="p-3 bg-yellow-50 rounded-lg text-sm text-yellow-800">
                            <strong>Catatan:</strong> Pastikan dokumen Google Docs dapat diakses publik atau bagikan dengan "Anyone with the link can view"
                        </div>
                        <div class="flex gap-3">
                            <button onclick="importFromGoogleDocs()" class="flex-1 bg-green-500 text-white py-3 rounded-lg font-semibold hover:bg-green-600 transition-colors">
                                Import
                            </button>
                            <button onclick="closeGoogleDocsModal()" class="flex-1 bg-gray-500 text-white py-3 rounded-lg font-semibold hover:bg-gray-600 transition-colors">
                                Batal
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Edit Game Name Modal -->
            <div id="editGameNameModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 hidden z-50">
                <div class="bg-white rounded-2xl shadow-2xl p-6 w-full max-w-md">
                    <div class="flex justify-between items-center mb-6">
                        <h3 class="text-xl font-bold text-gray-800">🎮 Edit Nama Game</h3>
                        <button onclick="closeEditGameNameModal()" class="text-gray-500 hover:text-gray-700 text-2xl font-bold">×</button>
                    </div>
                    
                    <div class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Nama Game Saat Ini:</label>
                            <div class="p-3 bg-gray-100 rounded-lg text-gray-700 font-medium" id="currentGameNameDisplay">
                                Game Edukasi
                            </div>
                        </div>
                        
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Nama Game Baru:</label>
                            <input type="text" id="newGameName" placeholder="Masukkan nama game baru..." class="w-full p-3 border-2 border-gray-300 rounded-lg focus:border-blue-500 focus:outline-none transition-colors" maxlength="50">
                            <div class="text-xs text-gray-500 mt-1">Maksimal 50 karakter</div>
                        </div>

                        <div class="p-3 bg-blue-50 rounded-lg text-sm text-blue-800">
                            <div class="flex items-start gap-2">
                                <span class="text-lg">💡</span>
                                <div>
                                    <strong>Tips nama game yang baik:</strong>
                                    <ul class="mt-1 text-xs">
                                        <li>• Singkat dan mudah diingat</li>
                                        <li>• Menggambarkan konten pembelajaran</li>
                                        <li>• Menarik untuk siswa</li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <div class="flex gap-3 pt-4">
                            <button onclick="saveGameName()" class="flex-1 bg-gradient-to-r from-blue-500 to-blue-600 text-white py-3 rounded-lg font-semibold hover:from-blue-600 hover:to-blue-700 transition-all duration-300">
                                💾 Simpan Perubahan
                            </button>
                            <button onclick="closeEditGameNameModal()" class="flex-1 bg-gray-500 text-white py-3 rounded-lg font-semibold hover:bg-gray-600 transition-colors">
                                ❌ Batal
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Package Management Cards -->
            <div class="bg-white rounded-2xl shadow-lg p-6 mb-6 fade-in">
                <div class="flex justify-between items-center mb-4">
                    <h3 class="text-xl font-bold text-gray-800">📦 Kelola Paket Soal</h3>
                    <button onclick="showCreatePackageModal()" class="bg-gradient-to-r from-green-500 to-green-600 text-white px-4 py-2 rounded-lg font-semibold hover:from-green-600 hover:to-green-700 transition-all duration-300 flex items-center gap-2">
                        ➕ Buat Paket Baru
                    </button>
                </div>
                <div class="grid md:grid-cols-3 gap-6" id="packageManagementCards">
                    <!-- Package cards will be dynamically generated -->
                </div>
            </div>

            <!-- Create Package Modal -->
            <div id="createPackageModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 hidden z-50">
                <div class="bg-white rounded-2xl shadow-2xl p-6 w-full max-w-lg max-h-[90vh] overflow-y-auto">
                    <div class="flex justify-between items-center mb-6">
                        <h3 class="text-2xl font-bold text-gray-800">➕ Buat Paket Soal Baru</h3>
                        <button onclick="closeCreatePackageModal()" class="text-gray-500 hover:text-gray-700 text-2xl font-bold">×</button>
                    </div>
                    
                    <div class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">📝 Nama Paket:</label>
                            <input type="text" id="createPackageName" placeholder="Masukkan nama paket..." class="w-full p-3 border-2 border-gray-300 rounded-lg focus:border-green-500 focus:outline-none transition-colors">
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">⚡ Tingkat Kesulitan:</label>
                            <select id="createPackageDifficulty" class="w-full p-3 border-2 border-gray-300 rounded-lg focus:border-green-500 focus:outline-none transition-colors">
                                <option value="Mudah">🟢 Mudah</option>
                                <option value="Sedang">🟡 Sedang</option>
                                <option value="Sulit">🔴 Sulit</option>
                            </select>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">🎨 Pilih Ikon Paket:</label>
                            <div class="grid grid-cols-6 gap-2 p-3 border-2 border-gray-300 rounded-lg">
                                <button type="button" onclick="selectCreateIcon('📚')" class="create-icon-option w-12 h-12 rounded-lg border-2 border-gray-200 hover:border-green-500 hover:bg-green-50 flex items-center justify-center text-2xl transition-all duration-200">📚</button>
                                <button type="button" onclick="selectCreateIcon('🧮')" class="create-icon-option w-12 h-12 rounded-lg border-2 border-gray-200 hover:border-green-500 hover:bg-green-50 flex items-center justify-center text-2xl transition-all duration-200">🧮</button>
                                <button type="button" onclick="selectCreateIcon('🔬')" class="create-icon-option w-12 h-12 rounded-lg border-2 border-gray-200 hover:border-green-500 hover:bg-green-50 flex items-center justify-center text-2xl transition-all duration-200">🔬</button>
                                <button type="button" onclick="selectCreateIcon('🌍')" class="create-icon-option w-12 h-12 rounded-lg border-2 border-gray-200 hover:border-green-500 hover:bg-green-50 flex items-center justify-center text-2xl transition-all duration-200">🌍</button>
                                <button type="button" onclick="selectCreateIcon('🎨')" class="create-icon-option w-12 h-12 rounded-lg border-2 border-gray-200 hover:border-green-500 hover:bg-green-50 flex items-center justify-center text-2xl transition-all duration-200">🎨</button>
                                <button type="button" onclick="selectCreateIcon('⚽')" class="create-icon-option w-12 h-12 rounded-lg border-2 border-gray-200 hover:border-green-500 hover:bg-green-50 flex items-center justify-center text-2xl transition-all duration-200">⚽</button>
                                <button type="button" onclick="selectCreateIcon('🎵')" class="create-icon-option w-12 h-12 rounded-lg border-2 border-gray-200 hover:border-green-500 hover:bg-green-50 flex items-center justify-center text-2xl transition-all duration-200">🎵</button>
                                <button type="button" onclick="selectCreateIcon('💻')" class="create-icon-option w-12 h-12 rounded-lg border-2 border-gray-200 hover:border-green-500 hover:bg-green-50 flex items-center justify-center text-2xl transition-all duration-200">💻</button>
                                <button type="button" onclick="selectCreateIcon('🏛️')" class="create-icon-option w-12 h-12 rounded-lg border-2 border-gray-200 hover:border-green-500 hover:bg-green-50 flex items-center justify-center text-2xl transition-all duration-200">🏛️</button>
                                <button type="button" onclick="selectCreateIcon('🌟')" class="create-icon-option w-12 h-12 rounded-lg border-2 border-gray-200 hover:border-green-500 hover:bg-green-50 flex items-center justify-center text-2xl transition-all duration-200">🌟</button>
                                <button type="button" onclick="selectCreateIcon('🚀')" class="create-icon-option w-12 h-12 rounded-lg border-2 border-gray-200 hover:border-green-500 hover:bg-green-50 flex items-center justify-center text-2xl transition-all duration-200">🚀</button>
                                <button type="button" onclick="selectCreateIcon('🎯')" class="create-icon-option w-12 h-12 rounded-lg border-2 border-gray-200 hover:border-green-500 hover:bg-green-50 flex items-center justify-center text-2xl transition-all duration-200">🎯</button>
                            </div>
                            <input type="hidden" id="createPackageIcon" value="📚">
                            <div class="mt-2 text-sm text-gray-600">
                                <span>Ikon terpilih: </span>
                                <span id="selectedCreateIconDisplay" class="text-2xl">📚</span>
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">📄 Deskripsi Paket:</label>
                            <textarea id="createPackageDescription" placeholder="Tambahkan deskripsi singkat untuk paket soal ini..." class="w-full p-3 border-2 border-gray-300 rounded-lg focus:border-green-500 focus:outline-none transition-colors h-24 resize-none"></textarea>
                        </div>

