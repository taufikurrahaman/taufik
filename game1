        // Image handling functions
        function previewImage(inputId, previewId) {
            const input = document.getElementById(inputId);
            const preview = document.getElementById(previewId);
            const previewImg = document.getElementById(previewId + 'Img');
            
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    previewImg.src = e.target.result;
                    preview.classList.remove('hidden');
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function removeImage(inputId, previewId) {
            const input = document.getElementById(inputId);
            const preview = document.getElementById(previewId);
            const previewImg = document.getElementById(previewId + 'Img');
            
            input.value = '';
            previewImg.src = '';
            preview.classList.add('hidden');
        }

        function addQuestion() {
            const selectedPackage = document.getElementById('newQuestionPackage').value;
            const question = document.getElementById('newQuestion').value.trim();
            const option1 = document.getElementById('option1').value.trim();
            const option2 = document.getElementById('option2').value.trim();
            const option3 = document.getElementById('option3').value.trim();
            const option4 = document.getElementById('option4').value.trim();
            const option5 = document.getElementById('option5').value.trim();
            const correct = document.getElementById('correctAnswer').value;

            if (!selectedPackage || !question || !option1 || !option2 || !option3 || !option4 || !option5 || correct === '') {
                alert('Silakan lengkapi semua field!');
                return;
            }

            // Get images
            const questionImageInput = document.getElementById('questionImage');
            const optionImageInputs = [
                document.getElementById('option1Image'),
                document.getElementById('option2Image'),
                document.getElementById('option3Image'),
                document.getElementById('option4Image'),
                document.getElementById('option5Image')
            ];

            // Convert images to base64
            const processImages = async () => {
                let questionImage = null;
                const optionImages = [null, null, null, null, null];

                // Process question image
                if (questionImageInput.files && questionImageInput.files[0]) {
                    questionImage = await fileToBase64(questionImageInput.files[0]);
                }

                // Process option images
                for (let i = 0; i < optionImageInputs.length; i++) {
                    if (optionImageInputs[i].files && optionImageInputs[i].files[0]) {
                        optionImages[i] = await fileToBase64(optionImageInputs[i].files[0]);
                    }
                }

                const newQuestion = {
                    question: question,
                    questionImage: questionImage,
                    options: [option1, option2, option3, option4, option5],
                    optionImages: optionImages,
                    correct: parseInt(correct)
                };

                // Add to selected package only
                questionPackages[selectedPackage].questions.push(newQuestion);
                
                // Auto-save changes
                autoSave();
                
                // Clear form
                clearAddQuestionForm();
                
                displayQuestions();
                alert('Soal berhasil ditambahkan dan disimpan!');
            };

            processImages();
        }

        function fileToBase64(file) {
            return new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.readAsDataURL(file);
                reader.onload = () => resolve(reader.result);
                reader.onerror = error => reject(error);
            });
        }

        function clearAddQuestionForm() {
            document.getElementById('newQuestionPackage').value = '1';
            document.getElementById('newQuestion').value = '';
            document.getElementById('option1').value = '';
            document.getElementById('option2').value = '';
            document.getElementById('option3').value = '';
            document.getElementById('option4').value = '';
            document.getElementById('option5').value = '';
            document.getElementById('correctAnswer').value = '';
            
            // Clear image inputs and previews
            const imageInputs = ['questionImage', 'option1Image', 'option2Image', 'option3Image', 'option4Image', 'option5Image'];
            const imagePreviews = ['questionImagePreview', 'option1ImagePreview', 'option2ImagePreview', 'option3ImagePreview', 'option4ImagePreview', 'option5ImagePreview'];
            
            imageInputs.forEach(inputId => {
                document.getElementById(inputId).value = '';
            });
            
            imagePreviews.forEach(previewId => {
                const preview = document.getElementById(previewId);
                const previewImg = document.getElementById(previewId + 'Img');
                if (preview && previewImg) {
                    preview.classList.add('hidden');
                    previewImg.src = '';
                }
            });
        }

        function displayQuestions() {
            const container = document.getElementById('questionsList');
            container.innerHTML = '';

            // Display questions from all packages
            Object.keys(questionPackages).forEach(packageKey => {
