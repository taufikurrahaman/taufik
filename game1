        function parseWordContent(content) {
            // Simplified Word content parser for demo
            // In real implementation, use libraries like mammoth.js or docx.js
            
            // Look for question patterns in the text
            let parsedContent = '';
            
            // Convert common Word patterns to CSV-like format
            const questionPattern = /SOAL #(\d+):|Paket Soal:\s*(\d+)|Pertanyaan:\s*(.+)|[A-E]\.\s*(.+)|Jawaban Benar:\s*([A-E])/gi;
            
            let currentQuestion = {
                package: '',
                question: '',
                options: ['', '', '', '', ''],
                correct: ''
            };
            
            let optionIndex = 0;
            const questions = [];
            
            const matches = content.matchAll(questionPattern);
            for (const match of matches) {
                if (match[0].includes('Paket Soal:')) {
                    currentQuestion.package = match[2] || '';
                } else if (match[0].includes('Pertanyaan:')) {
                    currentQuestion.question = match[3] || '';
                    optionIndex = 0;
                } else if (match[0].match(/^[A-E]\./)) {
                    if (optionIndex < 5) {
                        currentQuestion.options[optionIndex] = match[4] || '';
                        optionIndex++;
                    }
                } else if (match[0].includes('Jawaban Benar:')) {
                    currentQuestion.correct = match[5] || '';
                    
                    // Save completed question
                    if (currentQuestion.package && currentQuestion.question && 
                        currentQuestion.options.every(opt => opt.trim()) && 
                        currentQuestion.correct) {
                        questions.push({...currentQuestion});
                    }
                    
                    // Reset for next question
                    currentQuestion = {
                        package: '',
                        question: '',
                        options: ['', '', '', '', ''],
                        correct: ''
                    };
                    optionIndex = 0;
                }
            }
            
            // Convert to CSV format
            parsedContent = 'Paket Soal,Pertanyaan,Pilihan A,Pilihan B,Pilihan C,Pilihan D,Pilihan E,Jawaban Benar\n';
            questions.forEach(q => {
                parsedContent += `${q.package},"${q.question}","${q.options[0]}","${q.options[1]}","${q.options[2]}","${q.options[3]}","${q.options[4]}","${q.correct}"\n`;
            });
            
            return parsedContent;
        }

