        function saveToLocalStorage() {
            const gameData = {
                gameName: gameState.gameName,
                questionPackages: questionPackages,
                studentResults: gameState.studentResults,
                nextPackageId: nextPackageId,
                lastSaved: new Date().toISOString()
            };
            
            try {
                localStorage.setItem('gameEducationData', JSON.stringify(gameData));
                console.log('Data berhasil disimpan ke localStorage');
            } catch (error) {
                console.error('Error saving to localStorage:', error);
                alert('⚠️ Peringatan: Data tidak dapat disimpan secara otomatis. Pastikan browser mendukung penyimpanan lokal.');
            }
        }

        function loadFromLocalStorage() {
            try {
                const savedData = localStorage.getItem('gameEducationData');
                if (savedData) {
                    const gameData = JSON.parse(savedData);
                    
                    // Restore game name
                    if (gameData.gameName) {
                        gameState.gameName = gameData.gameName;
                    }
                    
                    // Restore question packages
                    if (gameData.questionPackages) {
                        Object.assign(questionPackages, gameData.questionPackages);
                    }
                    
                    // Restore student results
                    if (gameData.studentResults) {
                        gameState.studentResults = gameData.studentResults;
                    }
                    
                    // Restore next package ID
                    if (gameData.nextPackageId) {
                        nextPackageId = gameData.nextPackageId;
                    }
                    
                    console.log('Data berhasil dimuat dari localStorage');
                    console.log('Terakhir disimpan:', gameData.lastSaved);
                    return true;
                }
            } catch (error) {
                console.error('Error loading from localStorage:', error);
                alert('⚠️ Peringatan: Tidak dapat memuat data tersimpan. Menggunakan data default.');
            }
            return false;
